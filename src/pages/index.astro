---
import Base from "../layouts/Base.astro";

const name = "Luca Salvarani";
const description =
  "Software Developer and Open Source enthusiast based in Rome, Italy, with a passion for automating tedious tasks and optimizing workflows.";

// The CV is a separate GitHub Pages project site (LukeSavefrogs/curriculum-vitae), served on this same domain
const cvUrl = "/curriculum-vitae/";

const links = [
  { label: "GitHub", href: "https://github.com/LukeSavefrogs" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/lucasalvarani" },
  { label: "CV in Italiano", href: `${cvUrl}it/`, hreflang: "it" },
];
---

<Base title={name} description={description}>
  <main>
    <h1>{name}</h1>
    <p class="bio">{description}</p>

    <p>
      <a class="cta" href={cvUrl}>View my CV <span aria-hidden="true">→</span></a>
    </p>

    <ul class="links">
      {
        links.map(({ label, href, hreflang }) => (
          <li>
            <a href={href} hreflang={hreflang}>
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Base>

<style>
  main {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 100%;
    max-width: 46rem;
    margin: 0 auto;
    padding: 3rem 1rem;
  }

  h1 {
    font-size: 2.5rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 0 0 0.75rem;
  }

  .bio {
    font-size: 1.125rem;
    color: var(--muted);
    max-width: 36rem;
    margin: 0 0 2rem;
  }

  .cta {
    display: inline-block;
    padding: 0.7rem 1.4rem;
    border-radius: 0.5rem;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
    text-decoration: none;
  }

  .cta:hover,
  .cta:focus-visible {
    filter: brightness(1.1);
  }

  /* Inline list separated by a middle dot, as on the CV website */
  .links {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    font-size: 0.875rem;
  }

  .links li:not(:last-child)::after {
    content: "·";
    margin: 0 0.5em;
    color: var(--muted);
  }

  @media (max-width: 40rem) {
    h1 {
      font-size: 2rem;
    }

    .bio {
      font-size: 1rem;
    }
  }
</style>
